{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Report",
  "type": "object",
  "required": [
    "schema_version",
    "contract_type",
    "report_id",
    "task_id",
    "agent_id",
    "status",
    "summary",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract_type": {
      "const": "execution_report"
    },
    "report_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "result"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "inconclusive"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "handoff_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
